# Copy this file to .env and fill in values. .env is excluded from Git.

# Optional UN Comtrade subscription key (https://comtradedeveloper.un.org/).
# Without it the app uses the public preview endpoint (max 500 records per request).
COMTRADE_API_KEY=

# Optional overrides
# TRADE_DB_PATH=database/trade_intelligence.db
# MAX_UPLOAD_MB=50
# COMTRADE_MIN_INTERVAL=1.5
# COMTRADE_TIMEOUT=60
# COMTRADE_CACHE_HOURS=168
